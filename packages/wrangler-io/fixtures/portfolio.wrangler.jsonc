{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hassen-portfolio",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Without this, matching assets are served straight from the edge and the
    // Worker never runs — so its security/cache headers would not be applied.
    "run_worker_first": true
  }
}
